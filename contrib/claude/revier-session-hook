#!/bin/sh
# Publish the Claude Code session id to the panel revier reads.
#
# Install it as a SessionStart hook in ~/.claude/settings.json:
#
#   "hooks": {
#     "SessionStart": [
#       { "hooks": [ { "type": "command",
#                      "command": "/path/to/revier-session-hook" } ] }
#     ]
#   }
#
# Claude Code sends the hook payload on stdin as JSON. The id goes to whichever
# panel the agent is in: a tmux pane option when the agent runs under tmux, and
# a kitty user variable otherwise. Without it `revier session restore` still
# reopens the workspace, with the agent starting empty.
set -eu

payload=$(cat)

if command -v jq >/dev/null 2>&1; then
	id=$(printf '%s' "$payload" | jq -r '.session_id // empty')
else
	id=$(printf '%s' "$payload" | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
fi
[ -n "$id" ] || exit 0

if [ -n "${TMUX:-}" ]; then
	# One option carries every variable, so setting this one must keep the
	# others: tmux has no way to read a map of them back.
	current=$(tmux show-options -pqv @revier 2>/dev/null || true)
	kept=$(printf '%s' "$current" | tr ' ' '\n' | grep -v '^CS_SESSION=' | tr '\n' ' ')
	tmux set-option -p @revier "${kept}CS_SESSION=$id"
	exit 0
fi

# kitty reads the OSC from the pane's own terminal. It goes to the tty, not to
# stdout, which Claude Code captures.
# A session with no controlling terminal - `claude -p` in a script - has no
# /dev/tty to write to. There is then no panel to mark, and the hook says so by
# succeeding: failing it would report an error on every such start.
printf '\033]1337;SetUserVar=%s=%s\007' CS_SESSION "$(printf '%s' "$id" | base64 | tr -d '\n')" >/dev/tty 2>/dev/null || true
