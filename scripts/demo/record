#!/bin/sh
# Records the README's feature clips on a werft lease that scripts/lease-desktop
# prepared. Keys go in with virsh send-key, GNOME's own screencast records each
# clip at 30 fps, and compose.py lays the pressed keys over it. Nothing runs on
# this desktop.
#
# Usage: scripts/demo/record <lease-id> [output dir]. The output dir defaults
# to .github/assets/; give another one to compare first.
#
# - Give it a new lease in tier full: the clips take kitty's theme, font and
#   window frame from the user's setup, which a plain lease lacks. A lease
#   that ran other checks first keeps their workspace kitty, and the popup
#   shows their projects.
# - This machine needs ffmpeg with libwebp, python3-pil for /usr/bin/python3,
#   and the JetBrainsMono Nerd Font, which draws the keycaps.
# - The guest side uses a scratch configuration and fake agents. It points the
#   trigger key and the editor and ticket keys at them, sets a plain
#   background and 1920x1080, and teardown.sh puts all of it back on exit.
# - Open each clip in a browser before you commit: ffmpeg cannot decode an
#   animated WebP.
set -eu

id="${1:?usage: scripts/demo/record <lease-id> [output dir]}"
out=$(realpath -m "${2:-.github/assets}")
mkdir -p "$out"
dir=$(cd "$(dirname "$0")" && pwd)
read -r vm cfg <<EOF
$(werft --json leases | jq -r --arg id "$id" '.[] | select(.id == $id) | "\(.domain) \(.ssh_config)"')
EOF
[ -n "$cfg" ] || { echo "record: no lease $id in werft --json leases" >&2; exit 1; }
work=$(mktemp -d)
virsh() { command virsh -c qemu:///system "$@"; }
guest() { ssh -F "$cfg" -o ControlMaster=auto -o ControlPath="$work/ssh" -o ControlPersist=120 "$id" "$@"; }
trap 'guest "sh /tmp/rvdemo/teardown.sh"; rm -rf "$work"' EXIT

go build -ldflags "-X github.com/hk9890/revier/internal/build.Version=$(git describe --tags --abbrev=0)" \
	-o "$work/revier" ./cmd/revier
guest 'test -f /tmp/rvdemo/teardown.sh && sh /tmp/rvdemo/teardown.sh; mkdir -p /tmp/rvdemo/bin /tmp/rvdemo/clips'
scp -q -F "$cfg" -o ControlPath="$work/ssh" "$dir"/guest/* "$id":/tmp/rvdemo/
scp -q -F "$cfg" -o ControlPath="$work/ssh" "$work/revier" "$id":/tmp/rvdemo/bin/
guest 'sh /tmp/rvdemo/setup.sh'

send() { virsh send-key "$vm" --holdtime 60 "$@" >/dev/null; }
mark() { echo "$(date +%s%N) $*" >> "$work/$clip.log"; }
press() { label=$1; shift; mark key "$label"; send "$@"; }
type_slowly() {
	for c in $(echo "$1" | fold -w1); do
		send "KEY_$(echo "$c" | tr a-z A-Z)"
		sleep 0.25
	done
}
start() {
	clip=$1
	guest ". /tmp/rvdemo/env.sh; cd \$S/clips
		nohup /usr/bin/python3 \$S/screencast.py \$S/clips/$clip.webm > $clip.out 2>&1 & echo \$! > recorder.pid
		until grep -q recording $clip.out; do kill -0 \$(cat recorder.pid) || exit 1; sleep 0.05; done"
	mark start
	sleep 0.8
}
stop() {
	sleep "$1"
	mark end
	guest 'cd /tmp/rvdemo/clips; pid=$(cat recorder.pid); kill $pid; while kill -0 $pid 2>/dev/null; do sleep 0.1; done'
	scp -q -F "$cfg" -o ControlPath="$work/ssh" "$id:/tmp/rvdemo/clips/$clip.webm" "$work/"
}

# Start the popup once, so the clips show it warm, then put billing in front.
send KEY_LEFTALT KEY_SPACE
sleep 4
send KEY_ESC
sleep 1
guest '. /tmp/rvdemo/env.sh; revier go home -p billing >/dev/null'
sleep 2

start popup
press "Alt+Space" KEY_LEFTALT KEY_SPACE
sleep 1.2
type_slowly web
sleep 0.8
press "Tab" KEY_TAB
sleep 1.2
press "Enter" KEY_ENTER
stop 2.2

start agents
press "Alt+Space" KEY_LEFTALT KEY_SPACE
sleep 1.2
press "Alt+Space" KEY_LEFTALT KEY_SPACE
sleep 1.8
press "Down" KEY_DOWN
sleep 0.8
press "Down" KEY_DOWN
sleep 0.8
press "Up" KEY_UP
sleep 0.6
press "Up" KEY_UP
sleep 1.0
press "Enter" KEY_ENTER
stop 2.2

guest '. /tmp/rvdemo/env.sh; revier go home -p web-shop >/dev/null'
sleep 2
start tools
press "Ctrl+Shift+O" KEY_LEFTCTRL KEY_LEFTSHIFT KEY_O
sleep 2.6
press "Ctrl+Shift+O" KEY_LEFTCTRL KEY_LEFTSHIFT KEY_O
sleep 1.6
press "Ctrl+Shift+T" KEY_LEFTCTRL KEY_LEFTSHIFT KEY_T
sleep 1.8
press "Ctrl+Shift+T" KEY_LEFTCTRL KEY_LEFTSHIFT KEY_T
stop 1.8

start restore
press "Alt+Space" KEY_LEFTALT KEY_SPACE
sleep 1.0
press "Alt+S" KEY_LEFTALT KEY_S
sleep 1.4
press "Alt+Q" KEY_LEFTALT KEY_Q
sleep 1.0
press "Enter" KEY_ENTER
sleep 1.8
press "Enter" KEY_ENTER
# The popup shows the result, then quits; the next press starts it cold on
# the start dialog.
sleep 3.0
press "Alt+Space" KEY_LEFTALT KEY_SPACE
sleep 2.2
press "Enter" KEY_ENTER
# The restore opens each window over the popup, then raises the popup again
# on what it restored.
stop 12.0

for clip in popup agents tools restore; do
	/usr/bin/python3 "$dir/compose.py" "$work" "$clip" "$out/$clip.webp"
done
