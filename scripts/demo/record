#!/bin/sh
# Records the README demo on a libvirt VM with a logged-in GNOME desktop: the
# popup from its desktop key, a search, a jump to an agent, then the agent list.
# Keys go in with virsh send-key, frames come out with virsh screenshot, and
# compose.py draws each key and caption on. Nothing runs on this desktop.
# <vm> is the libvirt domain, reachable as `ssh <vm>`.
set -eu

vm="${1:?usage: scripts/demo/record <vm> [output.gif]}"
out=$(realpath -m "${2:-.github/assets/demo.gif}")
mkdir -p "$(dirname "$out")"
dir=$(cd "$(dirname "$0")" && pwd)
work=$(mktemp -d)
virsh() { command virsh -c qemu:///system "$@"; }
trap 'ssh "$vm" "sh /tmp/rvdemo/teardown.sh"; rm -rf "$work"' EXIT

ssh "$vm" 'rm -rf /tmp/rvdemo && mkdir -p /tmp/rvdemo/bin'
scp -q "$dir"/guest/* "$vm":/tmp/rvdemo/
scp -q bin/revier "$vm":/tmp/rvdemo/bin/
ssh "$vm" 'sh /tmp/rvdemo/setup.sh'

send() { virsh send-key "$vm" --holdtime 60 "$@" >/dev/null; }
mark() { echo "$(date +%s%N) $*" >> "$work/events.log"; }
press() { label=$1; shift; mark key "$label"; send "$@"; }
type_slowly() {
	for c in $(echo "$1" | fold -w1); do
		send "KEY_$(echo "$c" | tr a-z A-Z)"
		sleep 0.35
	done
}

# Start the popup once, so the recording shows it warm, then put billing in front.
send KEY_LEFTALT KEY_SPACE
sleep 4
send KEY_ESC
sleep 1
ssh "$vm" '. /tmp/rvdemo/env.sh; revier go home -p billing >/dev/null'
sleep 2

mkdir "$work/frames"
(while [ ! -e "$work/stop" ]; do virsh screenshot "$vm" "$work/frames/$(date +%s%N).ppm" >/dev/null 2>&1; done) &
capture=$!

mark start
mark caption "1  Open the popup, find a project, jump to its agent"
sleep 2.5
press "Alt+Space" KEY_LEFTALT KEY_SPACE
sleep 2.2
type_slowly web
sleep 1.5
press "Tab" KEY_TAB
sleep 1.8
press "Enter" KEY_ENTER
sleep 3.5
mark caption "2  See every agent, pick the one that needs you"
sleep 1.5
press "Alt+Space" KEY_LEFTALT KEY_SPACE
sleep 2
press "Alt+Space" KEY_LEFTALT KEY_SPACE
sleep 2.5
press "Down" KEY_DOWN
sleep 1.2
press "Down" KEY_DOWN
sleep 1.2
press "Up" KEY_UP
sleep 0.9
press "Up" KEY_UP
sleep 1.5
press "Enter" KEY_ENTER
sleep 3.5
mark end

touch "$work/stop"
wait $capture
python3 "$dir/compose.py" "$work" "$out"
